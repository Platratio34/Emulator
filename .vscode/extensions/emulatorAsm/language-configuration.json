{
    "comments": {
        "lineComment": {"comment": "//"}
    },
    "brackets": [
        ["[","]"],
        ["(",")"]
    ],
    "autoClosingPairs": [
        {
            "open": "\"",
            "close": "\"",
            "notIn": [
                "string"
            ]
        }
    ],
    "autoCloseBefore": ";:.,=}])>` \n\t",
    "surroundingPairs": [
        [
            "\"",
            "\""
        ],
        [
            "'",
            "'"
        ]
    ],
    "wordPattern": "([^\\s#&:,]+)"
}