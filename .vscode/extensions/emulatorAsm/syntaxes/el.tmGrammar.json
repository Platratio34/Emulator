{
    "name": "Emulator Language",
    "scopeName": "source.el",
    "fileTypes": [],
    "patterns": [
        {
            "name": "comment.line",
            "match": "(//.*)"
        },
        {
            "begin": "/\\**",
            "end": "\\*/",
            "name": "comment.block.doc"
        },
        {
            "begin": "/\\*",
            "end": "\\*/",
            "name": "comment.block"
        }
    ],
    "repository": {
        "string.quoted": {
            "match": "(\")((?:[^\"\\\\](?:\\\\.|))*)(\")",
            "captures": {
                "1": {
                    "name": "keyword.quote"
                },
                "2": {
                    "patterns": [
                        { "include": "#char.escaped"},
                        { "match":".", "name": "string.quoted"}
                    ]
                },
                "3": {
                    "name": "keyword.quote"
                }
            }
        },
        "char.quoted": {
            "match": "(')(\\\\?.)(')",
            "captures": {
                "1": {
                    "name": "keyword.quote"
                },
                "2": {
                    "patterns": [
                        { "include": "#char.escaped"},
                        {"match":".", "name": "string.quoted"}
                    ]
                    
                },
                "3": {
                    "name": "keyword.quote"
                }
            }
        },
        "char.escaped": {
            "match": "(\\\\.)",
            "name": "constant.character.escape"
        },
        "identifier.stack": {
            "match": "(\\w[\\w\\d_]*)\\.(\\w[\\w\\d_\\.]*)|(\\w[\\w\\d_]*)",
            "captures": {
                "1": {
                    "name": "entity.name.variable"
                },
                "2": {
                    "patterns": [{"include": "#identifier.stack"}]
                },
                "3": {
                    "name": "entity.name.variable"
                }
            }
        },
        "identifier.function": {
            "match": "(\\w[\\w\\d_]*)\\.(\\w[\\w\\d_\\.]*)|(\\w[\\w\\d_]*)",
            "captures": {
                "1": {
                    "name": "entity.name.variable"
                },
                "2": {
                    "patterns": [{"include": "#identifier.function"}]
                },
                "3": {
                    "name": "entity.name.function"
                }
            }
        },
        "identifier.type": {
            "match": "(\\w[\\w\\d_]*)\\.(\\w[\\w\\d_\\.]*)|(\\w[\\w\\d_]*)",
            "captures": {
                "1": {
                    "name": "entity.name.type"
                },
                "2": {
                    "patterns": [{"include": "#identifier.type"}]
                },
                "3": {
                    "name": "entity.name.type"
                }
            }
        },
        "type.list": {
            "match": "(\\w[\\w\\d_\\.]*)(?:\\s|\\*|\\&)?(?:,\\s*(.*))?",
            "captures": {
                "1": {
                    "patterns": [{"include": "#identifier.type"}]
                },
                "2": {
                    "patterns": [{"include": "#type.list"}]
                }
            }
        }
    }
}